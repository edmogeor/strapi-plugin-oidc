{
  "name": "strapi-plugin-oidc",
  "version": "2.0.0",
  "description": "A Strapi plugin that provides OpenID Connect (OIDC) authentication functionality for the Strapi Admin Panel.",
  "strapi": {
    "displayName": "OIDC Plugin",
    "name": "strapi-plugin-oidc",
    "description": "A Strapi plugin that provides OpenID Connect (OIDC) authentication functionality for the Strapi Admin Panel.",
    "kind": "plugin"
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "typecheck": "npm run typecheck:production && npm run typecheck:test",
    "typecheck:production": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run -c vitest.config.unit.ts",
    "test:e2e": "vitest run -c vitest.config.e2e.ts",
    "lint": "eslint",
    "fallow:check": "fallow",
    "fallow:fix": "fallow fix --yes",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "strapi",
    "strapi-plugin",
    "oidc",
    "oauth",
    "sso",
    "authentication",
    "keycloak",
    "auth0",
    "okta",
    "azure-ad",
    "authentik",
    "authelia"
  ],
  "peerDependencies": {
    "@strapi/strapi": "^5.50.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "styled-components": "^6.4.4"
  },
  "dependencies": {
    "@strapi/design-system": "^2.2.3",
    "@strapi/icons": "^2.2.3",
    "@strapi/utils": "^5.50.2",
    "generate-password": "^1.7.1",
    "lucide-react": "^1.25.0",
    "openid-client": "^6.8.4",
    "rate-limiter-flexible": "^11.2.0",
    "react-intl": "^6.8.9",
    "jose": "^6.2.3",
    "zod": "^3.25.76"
  },
  "author": {
    "name": "edmogeor",
    "url": "https://github.com/edmogeor/strapi-plugin-oidc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edmogeor/strapi-plugin-oidc"
  },
  "bugs": {
    "url": "https://github.com/edmogeor/strapi-plugin-oidc/issues"
  },
  "maintainers": [
    {
      "name": "edmogeor"
    }
  ],
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@strapi/sdk-plugin": "^6.1.1",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.5",
    "react": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "styled-components": "^6.3.12",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  }
}
